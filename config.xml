<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ssh.pty.terminal" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>PTY Terminal</name>
    <description>
        PTY terminal for Android
    </description>
    <author email="suniltinku1980@gmail.com" href="https://ai.studio/build">
        AI Studio
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="AndroidXEnabled" value="true" />
    <preference name="EnableGradlePrameters" value="true" />

    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="www/app-icon.png" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#1E1E1E" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="android-usesCleartextTraffic" value="true" />

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
            <uses-permission android:name="android.permission.VIBRATE" />
        </config-file>
    </platform>
</widget>
